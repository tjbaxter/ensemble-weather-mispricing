# Weather bot local artifacts
weather-bot/.env
weather-bot/.venv/
weather-bot/__pycache__/

# Ignore most of logs/ but track the key output CSVs so Streamlit Cloud sees them
weather-bot/logs/*
!weather-bot/logs/resolved.csv
!weather-bot/logs/resolved_archive_*.csv
!weather-bot/logs/signals.csv
!weather-bot/logs/trades.csv

# Track position files so Streamlit Cloud shows live prices for all strategies
!weather-bot/data/positions.json
!weather-bot/data/positions_live.json
!weather-bot/data/positions_shadow_2a.json
!weather-bot/data/positions_shadow_2b.json
!weather-bot/data/positions_shadow_2c.json

# CV notes — local only
weather-bot/CV_QUANT_NOTES.md
weather-bot/logs/deep/signal_eval_*.jsonl
