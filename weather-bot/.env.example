# Runtime mode (paper-first)
PAPER_TRADING=true
LIVE_TRADING=false
BANKROLL=300
REQUIRE_VPN=true

# Polymarket credentials (required only for live trading)
# POLYMARKET_PK = hex private key for Polygon wallet (signs orders)
# POLYMARKET_FUNDER = Polygon wallet address (funds USDC)
# POLYMARKET_API_KEY = optional; if unset, PK is used for CLOB auth
POLYMARKET_PK=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=

# Forecast provider keys
MET_OFFICE_API_KEY=
ACCUWEATHER_API_KEY=

# Optional runtime controls
# STATION_PRIORITY_FILTER=HIGH,MEDIUM,LOW
# CLOB_PREFILTER_PRIORITY=HIGH,MEDIUM,LOW
# DIAGNOSTIC_MODE=false
#
# Dashboard controls
# DASHBOARD_DATA_SOURCE=auto    # auto | local | github
# DASHBOARD_READ_ONLY=false     # set true for production dashboards

# Kill switch: create data/.kill_switch file to halt all live trading immediately
# To activate:  touch data/.kill_switch
# To deactivate: rm data/.kill_switch
