# Runtime mode (paper-first)
PAPER_TRADING=true
LIVE_TRADING=false
BANKROLL=300
REQUIRE_VPN=true

# Polymarket credentials (required only for live trading)
# POLYMARKET_PK = hex private key for Polygon wallet (signs orders)
# POLYMARKET_FUNDER = Polygon wallet address (funds USDC)
# POLYMARKET_API_KEY = optional; if unset, PK is used for CLOB auth
POLYMARKET_PK=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=

# Forecast provider keys
MET_OFFICE_API_KEY=
ACCUWEATHER_API_KEY=

# weather.com / Weather Underground observations API (required for backtest + resolution-parity scripts)
WU_OBS_KEY=

# Optional runtime controls
# STATION_PRIORITY_FILTER=HIGH,MEDIUM,LOW
# CLOB_PREFILTER_PRIORITY=HIGH,MEDIUM,LOW
# DIAGNOSTIC_MODE=false
#
# Dashboard controls
# DASHBOARD_DATA_SOURCE=auto    # auto | local | github | api
# DASHBOARD_READ_ONLY=false     # set true for production dashboards
# DASHBOARD_API_HOST=127.0.0.1
# DASHBOARD_API_PORT=8510
# DASHBOARD_API_TOKEN=
# DASHBOARD_API_BASE_URL=
# DASHBOARD_API_VERIFY_SSL=true
#
# Realtime settlement watcher (read-only sidecar; does not mutate positions/resolved logs)
# SETTLEMENT_WATCHER_POLL_SECONDS=10
# SETTLEMENT_WATCHER_OFFICIAL_REFRESH_SECONDS=60
# SETTLEMENT_WATCHER_FINAL_PRICE_THRESHOLD=0.995
# SETTLEMENT_WATCHER_SPLIT_PRICE_TOLERANCE=0.05

# Kill switch: create data/.kill_switch file to halt all live trading immediately
# To activate:  touch data/.kill_switch
# To deactivate: rm data/.kill_switch
